# === Version control ===
.git/
.gitignore
.gitattributes

# === Secrets (CRITICAL — never let these into the image) ===
.env
.env.*
!.env-template
*.pem
*.key

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# === uv ===
# Don't ignore uv.lock — we need it inside the image for reproducible installs
# (uv.lock is intentionally NOT in this list)

# === Node / Tailwind ===
node_modules/
theme/static_src/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Django ===
db.sqlite3
db.sqlite3-journal
staticfiles/
media/uploads/
*.log

# === Docker / Compose ===
# docker-compose.yml is for local dev only, no need to bake into the image
docker-compose.yml
docker-compose.*.yml
Dockerfile
.dockerignore

# === Editor / IDE ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# === Misc ===
README.md
LICENSE
Makefile
.github/
docs/
tests/
*.md